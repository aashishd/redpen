{
  "name": "redpen-review",
  "version": "0.3.0",
  "description": "Collect red-pen feedback on Markdown, HTML, or plain-text files in the browser. Feedback is printed to stdout for a coding agent to act on.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "test": "node --test"
  },
  "bin": {
    "redpen": "bin/redpen.mjs"
  },
  "files": [
    "bin",
    "ui",
    "agents",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "annotation",
    "markdown",
    "html",
    "review",
    "feedback",
    "coding-agent",
    "claude-code",
    "codex",
    "opencode"
  ]
}
