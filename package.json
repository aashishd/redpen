{
  "name": "redpen-review",
  "version": "0.8.0",
  "description": "Collect red-pen feedback on Markdown, HTML, or plain-text files in the browser. Feedback is printed to stdout for a coding agent to act on.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aashishd/redpen.git"
  },
  "homepage": "https://github.com/aashishd/redpen#readme",
  "type": "module",
  "scripts": {
    "test": "node --test"
  },
  "bin": {
    "redpen": "bin/redpen.mjs"
  },
  "files": [
    "bin",
    "ui",
    "agents",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "annotation",
    "markdown",
    "html",
    "review",
    "feedback",
    "coding-agent",
    "claude-code",
    "codex",
    "opencode"
  ],
  "dependencies": {
    "postcss": "^8.5.26",
    "postcss-value-parser": "^4.2.0"
  }
}
